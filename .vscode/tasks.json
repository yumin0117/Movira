{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Movira: Build and test",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\build.cmd",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Movira: Web local server",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/serve-web.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
